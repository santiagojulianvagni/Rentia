# Base de datos (Neon). En Vercel las completa sola la integración de Neon.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk (cuentas y login)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/ingresar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# URL pública de la app, con https y sin barra final (ej: https://rentia.vercel.app)
RENTIA_PUBLIC_ORIGIN=

# Clave de 32 bytes en base64 para cifrar los tokens de las integraciones.
# Generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Secreto del cron de Vercel (cualquier texto largo al azar)
CRON_SECRET=

# Tiendanube
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=

# Meta Ads
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v23.0

# Mercado Libre
MELI_APP_ID=
MELI_APP_SECRET=
